<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <TaiwuGameDirectory Condition="'$(TaiwuGameDirectory)' == '' and '$(OS)' == 'Windows_NT'">C:\Program Files (x86)\Steam\steamapps\common\The Scroll Of Taiwu</TaiwuGameDirectory>
    <TaiwuBackendDirectory>$(TaiwuGameDirectory)\Backend</TaiwuBackendDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaiWu.Application\TaiWu.Application.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(TaiwuBackendDirectory)\GameData.dll')">
    <TaiwuGameAssembly Include="$(TaiwuBackendDirectory)\GameData*.dll" />
    <Reference Include="@(TaiwuGameAssembly)">
      <HintPath>%(TaiwuGameAssembly.Identity)</HintPath>
      <Private>true</Private>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Reference>
    <None
      Include="$(TaiwuBackendDirectory)\GameData.ActionPlanning.ActionImpl.dll"
      Link="GameData.ActionPlanning.ActionImpl.dll"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="Never" />
    <None
      Include="$(TaiwuBackendDirectory)\0Harmony.dll"
      Link="0Harmony.dll"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="Never" />
    <None
      Include="$(TaiwuBackendDirectory)\e_sqlite3.dll"
      Link="e_sqlite3.dll"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="Never" />
    <None
      Include="$(TaiwuBackendDirectory)\steam_api64.dll"
      Link="steam_api64.dll"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="Never" />
  </ItemGroup>

  <Target Name="ValidateTaiwuGameDirectory" BeforeTargets="ResolveReferences">
    <Error
      Condition="!Exists('$(TaiwuBackendDirectory)\GameData.dll')"
      Text="Taiwu game assemblies were not found. Set the MSBuild property TaiwuGameDirectory to the game's installation directory." />
  </Target>
</Project>
