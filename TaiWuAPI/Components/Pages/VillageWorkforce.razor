@page "/village-workforce"
@implements IAsyncDisposable
@using Microsoft.JSInterop
@using TaiWu.Application.VillageWorkforce
@using TaiWu.Domain.VillageWorkforce
@using TaiWuAPI.Presentation
@inject BuildVillageWorkforce BuildWorkforce
@inject IVillageWorkforceSnapshotReader SnapshotReader
@inject IJSRuntime JS
@inject ILogger<VillageWorkforce> Logger

<PageTitle>TaiWu Helper · @Text(VillageWorkforceUiTextKey.PageTitle)</PageTitle>

<section class="workforce-hero">
    <div>
        <p class="eyebrow">@Text(VillageWorkforceUiTextKey.Eyebrow)</p>
        <h1>@Text(VillageWorkforceUiTextKey.PageTitle)</h1>
        <p class="hero-copy">@Text(VillageWorkforceUiTextKey.HeroCopy)</p>
    </div>
    <div class="boundary-card" role="note">
        <strong>@Text(VillageWorkforceUiTextKey.InformationOnly)</strong>
        <span>@Text(VillageWorkforceUiTextKey.InformationNotice)</span>
    </div>
</section>

<p class="workforce-boundary" role="note">
    @Text(VillageWorkforceUiTextKey.CandidateBoundary)
</p>

<section class="workforce-controls"
         aria-labelledby="workforce-controls-heading"
         aria-busy="@(_isLoading || _targetsLoading).ToString().ToLowerInvariant()">
    <div class="section-heading">
        <div>
            <p class="eyebrow">@Text(VillageWorkforceUiTextKey.Objective)</p>
            <h2 id="workforce-controls-heading">
                @Text(VillageWorkforceUiTextKey.ObjectiveLabel)
            </h2>
            <p>@Text(VillageWorkforceUiTextKey.ObjectiveDescription)</p>
        </div>
        @if (_targetsLoading)
        {
            <span class="working-status" role="status">
                @Text(VillageWorkforceUiTextKey.LoadingTargets)
            </span>
        }
    </div>

    @if (_targetNotice is not null)
    {
        <section class="message-card page-state problem-state" role="alert">
            <div>
                <strong>@_targetNotice.Title</strong>
                <p>@_targetNotice.Message</p>
            </div>
            @if (_targetNotice.CanRetry)
            {
                <button type="button"
                        class="secondary-button"
                        @onclick="LoadTargetsAsync"
                        disabled="@_targetsLoading">
                    @Text(VillageWorkforceUiTextKey.RetryTargets)
                </button>
            }
        </section>
    }
    else if (!_targetsLoading && _targets.Count == 0)
    {
        <section class="message-card page-state" role="status">
            <div>
                <strong>@Text(VillageWorkforceUiTextKey.NoTargetsTitle)</strong>
                <p>@Text(VillageWorkforceUiTextKey.NoTargetsMessage)</p>
            </div>
            <button type="button"
                    class="secondary-button"
                    @onclick="LoadTargetsAsync">
                @Text(VillageWorkforceUiTextKey.RetryTargets)
            </button>
        </section>
    }

    <div class="workforce-objective-grid">
        <div class="workforce-fixed-objective">
            <span>@Text(VillageWorkforceUiTextKey.Objective)</span>
            <strong>@Text(VillageWorkforceUiTextKey.ObjectiveLabel)</strong>
            <small>@Text(VillageWorkforceUiTextKey.QualificationMeaning)</small>
        </div>
        <div class="workforce-target-pickers">
            <label class="workforce-target-control">
                <span>@Text(VillageWorkforceUiTextKey.Shop)</span>
                <select value="@DraftGroupValue"
                        @onchange="SetTargetGroup"
                        disabled="@(_isLoading || _targetsLoading || _targets.Count == 0)">
                    @if (TargetGroups.Count != 1)
                    {
                        <option value="">@Text(VillageWorkforceUiTextKey.ChooseShop)</option>
                    }
                    @foreach (var group in TargetGroups)
                    {
                        <option value="@group.GroupIndex">@group.Label</option>
                    }
                </select>
            </label>
            <label class="workforce-target-control">
                <span>@Text(VillageWorkforceUiTextKey.AssignmentTarget)</span>
                <select value="@DraftTargetValue"
                        @onchange="SetTarget"
                        disabled="@(_isLoading || _targetsLoading || DraftGroup is null)">
                    @if (DraftGroup?.Positions.Count != 1)
                    {
                        <option value="">@Text(VillageWorkforceUiTextKey.ChooseTarget)</option>
                    }
                    @foreach (var option in DraftGroup?.Positions ?? [])
                    {
                        <option value="@option.OptionIndex">@option.Label</option>
                    }
                </select>
            </label>
        </div>
        <div class="workforce-inspect-action">
            <button type="button"
                    class="primary-button"
                    @onclick="InspectAsync"
                    disabled="@(!CanInspect)">
                @Text(_isLoading
                    ? VillageWorkforceUiTextKey.InspectingPosition
                    : VillageWorkforceUiTextKey.InspectPosition)
            </button>
            <small>@Text(VillageWorkforceUiTextKey.TargetHelp)</small>
        </div>
    </div>
</section>

<section class="workforce-result-region"
         aria-live="polite"
         aria-busy="@_isLoading.ToString().ToLowerInvariant()">
    @if (_isLoading)
    {
        <section class="message-card page-state" role="status">
            <div>
                <strong>@Text(VillageWorkforceUiTextKey.ReadingTitle)</strong>
                <p>@Text(VillageWorkforceUiTextKey.ReadingMessage)</p>
            </div>
        </section>
    }
    else if (_notice is not null)
    {
        <section id="workforce-error-summary"
                 class="message-card page-state problem-state"
                 role="alert"
                 tabindex="-1">
            <div>
                <strong>@_notice.Title</strong>
                <p>@_notice.Message</p>
            </div>
            @if (_notice.CanRetry && DraftValid)
            {
                <button type="button"
                        class="secondary-button"
                        @onclick="InspectAsync">
                    @Text(VillageWorkforceUiTextKey.RetryRead)
                </button>
            }
        </section>
    }
    else if (_model is not null)
    {
        <VillageWorkforceResults @key="ResultsRenderKey"
                                 Model="_model"
                                 State="_interaction"
                                 Comparison="_comparison"
                                 IsPrevious="IsPreviousResult"
                                 ComparisonChanged="OnComparisonChanged"
                                 ComparisonCleared="FocusAfterComparisonClear" />
    }
</section>

@code {
    private static readonly WorkforceObjectiveIdentity Objective = new(
        WorkforceObjectiveKind.ShopManagerBaseLifeSkillQualification,
        VerifiedVillageWorkforceRules.ObjectiveVersion);
    private readonly VillageWorkforceInteractionState _interaction = new();
    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private IReadOnlyList<ShopManagerTarget> _targets = [];
    private int? _draftGroupIndex;
    private int? _draftTargetIndex;
    private int? _submittedTargetIndex;
    private VillageWorkforceFinderResult? _result;
    private VillageWorkforceSnapshotReadResult? _snapshotRead;
    private VillageWorkforceViewModel? _model;
    private VillageWorkforceComparisonViewModel? _comparison;
    private VillageWorkforceNoticeViewModel? _notice;
    private VillageWorkforceNoticeViewModel? _targetNotice;
    private VillageWorkforceFinderStatus? _noticeStatus;
    private VillageWorkforceSnapshotReadStatus? _targetNoticeStatus;
    private bool _noticeWasCancelled;
    private bool _targetNoticeWasCancelled;
    private CancellationTokenSource? _requestCancellation;
    private bool _targetsLoading;
    private bool _isLoading;
    private string? _pendingFocusId;
    private TaiwuLanguage _mappedLanguage;

    [CascadingParameter]
    public TaiwuLanguage Language { get; set; } = TaiwuLanguage.English;

    private IReadOnlyList<VillageWorkforceTargetGroupViewModel> TargetGroups =>
        _targets.Select((target, index) => (Target: target, Index: index))
            .GroupBy(item => item.Target.Identity.Building)
            .Select((group, groupIndex) =>
            {
                var first = group.First().Target;
                var display = _snapshotRead?.TargetDisplays.SingleOrDefault(item =>
                    item.Identity == first.Identity);
                var positions = group.Select(item =>
                {
                    var currentIdentity = _snapshotRead?.Snapshot?
                        .CurrentAssignments.Single(assignment =>
                            assignment.Target == item.Target.Identity).Worker;
                    var currentDisplay = currentIdentity is null
                        ? null
                        : _snapshotRead?.WorkerDisplays.SingleOrDefault(worker =>
                            worker.Identity == currentIdentity);
                    return new VillageWorkforceTargetOptionViewModel(
                        item.Index,
                        VillageWorkforceViewModelMapper.TargetPositionLabel(
                            item.Target,
                            currentDisplay,
                            Language));
                }).ToArray();
                return new VillageWorkforceTargetGroupViewModel(
                    groupIndex,
                    VillageWorkforceViewModelMapper.TargetGroupLabel(
                        display,
                        Language,
                        groupIndex + 1),
                    positions);
            }).ToArray();

    private VillageWorkforceTargetGroupViewModel? DraftGroup =>
        _draftGroupIndex.HasValue
        && _draftGroupIndex.Value >= 0
        && _draftGroupIndex.Value < TargetGroups.Count
            ? TargetGroups[_draftGroupIndex.Value]
            : null;

    private string DraftGroupValue => _draftGroupIndex?.ToString() ?? "";

    private string DraftTargetValue => _draftTargetIndex?.ToString() ?? "";

    private bool DraftValid => _draftTargetIndex.HasValue
        && _draftTargetIndex.Value >= 0
        && _draftTargetIndex.Value < _targets.Count
        && DraftGroup?.Positions.Any(option =>
            option.OptionIndex == _draftTargetIndex.Value) == true;

    private bool CanInspect => DraftValid
        && !_isLoading
        && !_targetsLoading;

    private bool IsPreviousResult => _model is not null
        && _draftTargetIndex != _submittedTargetIndex;

    private string ResultsRenderKey =>
        $"{_submittedTargetIndex}:{IsPreviousResult}:"
        + string.Join(',', _interaction.SelectedCharacterIds);

    protected override async Task OnInitializedAsync()
    {
        await LoadTargetsAsync();
    }

    protected override void OnParametersSet()
    {
        if (_mappedLanguage == Language)
        {
            return;
        }

        if (_result is not null && _result.HasAuthoritativeResult)
        {
            MapCurrentResult();
        }

        RemapNotices();
        _mappedLanguage = Language;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingFocusId is null)
        {
            return;
        }

        var focusId = _pendingFocusId;
        _pendingFocusId = null;
        try
        {
            await JS.InvokeVoidAsync("taiwuHelper.focusElement", focusId);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task LoadTargetsAsync()
    {
        _targetsLoading = true;
        ClearTargetNotice();
        try
        {
            var read = await SnapshotReader.ReadAsync(
                VillageWorkforceSnapshotReadRequest.Current,
                _lifetimeCancellation.Token);
            if (read.Snapshot is null)
            {
                _snapshotRead = null;
                _targets = [];
                _draftGroupIndex = null;
                _draftTargetIndex = null;
                SetTargetFailure(read.Status);
                return;
            }

            _snapshotRead = read;
            _targets = read.Snapshot.Targets;
            _draftGroupIndex = TargetGroups.Count == 1 ? 0 : null;
            _draftTargetIndex = DraftGroup?.Positions.Count == 1
                ? DraftGroup.Positions[0].OptionIndex
                : null;
        }
        catch (OperationCanceledException) when (
            !_lifetimeCancellation.IsCancellationRequested)
        {
            _snapshotRead = null;
            _targets = [];
            _draftGroupIndex = null;
            _draftTargetIndex = null;
            SetTargetCancelled();
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Village workforce targets could not be read safely.");
            _snapshotRead = null;
            _targets = [];
            _draftGroupIndex = null;
            _draftTargetIndex = null;
            SetTargetFailure(VillageWorkforceSnapshotReadStatus.ReadFailed);
        }
        finally
        {
            _targetsLoading = false;
        }
    }

    private void SetTargetGroup(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        _draftGroupIndex = int.TryParse(value, out var index)
            && index >= 0
            && index < TargetGroups.Count
                ? index
                : null;
        _draftTargetIndex = DraftGroup?.Positions.Count == 1
            ? DraftGroup.Positions[0].OptionIndex
            : null;
    }

    private void SetTarget(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        _draftTargetIndex = int.TryParse(value, out var index)
            && index >= 0
            && index < _targets.Count
            && DraftGroup?.Positions.Any(option =>
                option.OptionIndex == index) == true
                ? index
                : null;
    }

    private Task InspectAsync()
    {
        if (!CanInspect || _snapshotRead is null)
        {
            return Task.CompletedTask;
        }

        var targetIndex = _draftTargetIndex!.Value;
        var target = _targets[targetIndex].Identity;
        _requestCancellation?.Cancel();
        _requestCancellation?.Dispose();
        _requestCancellation = CancellationTokenSource
            .CreateLinkedTokenSource(_lifetimeCancellation.Token);
        _isLoading = true;
        ClearInspectionNotice();
        _result = null;
        _model = null;
        _comparison = null;
        _interaction.Reset();
        try
        {
            var result = BuildWorkforce.Execute(
                _snapshotRead,
                new VillageWorkforceFinderRequest(target, Objective),
                _requestCancellation.Token);
            if (result.HasAuthoritativeResult)
            {
                _result = result;
                _submittedTargetIndex = targetIndex;
                MapCurrentResult();
                _pendingFocusId = "workforce-result-heading";
            }
            else
            {
                SetInspectionFailure(result.Status);
                _pendingFocusId = "workforce-error-summary";
            }
        }
        catch (OperationCanceledException) when (
            !_lifetimeCancellation.IsCancellationRequested)
        {
            SetInspectionCancelled();
            _pendingFocusId = "workforce-error-summary";
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Village workforce inspection failed safely.");
            SetInspectionFailure(VillageWorkforceFinderStatus.ReadFailed);
            _pendingFocusId = "workforce-error-summary";
        }
        finally
        {
            _isLoading = false;
        }

        return Task.CompletedTask;
    }

    private void MapCurrentResult()
    {
        if (_result is null || !_submittedTargetIndex.HasValue)
        {
            return;
        }

        _model = VillageWorkforceViewModelMapper.Map(
            _result,
            Language,
            _submittedTargetIndex.Value + 1);
        _mappedLanguage = Language;
        RebuildComparison();
    }

    private void RebuildComparison()
    {
        if (_result is null || _model is null || !_interaction.ComparisonReady)
        {
            _comparison = null;
            return;
        }

        _comparison = VillageWorkforceViewModelMapper.MapComparison(
            _result,
            _model,
            _interaction.SelectedCharacterIds[0],
            _interaction.SelectedCharacterIds[1],
            Language);
    }

    private void OnComparisonChanged()
    {
        RebuildComparison();
        if (_model is null)
        {
            return;
        }

        var selectedAlternative = _interaction.SelectedCharacterIds
            .FirstOrDefault(characterId =>
                characterId != _model.Current.CharacterId);
        var focusTarget = _model.Candidates.FirstOrDefault(candidate =>
            candidate.CharacterId == selectedAlternative);
        if (focusTarget is not null)
        {
            _pendingFocusId =
                $"workforce-compare-{focusTarget.DisplayOrdinal}";
        }
    }

    private void FocusAfterComparisonClear(string elementId) =>
        _pendingFocusId = elementId;

    private void ClearTargetNotice()
    {
        _targetNotice = null;
        _targetNoticeStatus = null;
        _targetNoticeWasCancelled = false;
    }

    private void SetTargetFailure(VillageWorkforceSnapshotReadStatus status)
    {
        _targetNoticeStatus = status;
        _targetNoticeWasCancelled = false;
        _targetNotice = VillageWorkforceViewModelMapper.MapDiscoveryFailure(
            status,
            Language);
        _mappedLanguage = Language;
    }

    private void SetTargetCancelled()
    {
        _targetNoticeStatus = null;
        _targetNoticeWasCancelled = true;
        _targetNotice = CancelledNotice();
        _mappedLanguage = Language;
    }

    private void ClearInspectionNotice()
    {
        _notice = null;
        _noticeStatus = null;
        _noticeWasCancelled = false;
    }

    private void SetInspectionFailure(VillageWorkforceFinderStatus status)
    {
        _noticeStatus = status;
        _noticeWasCancelled = false;
        _notice = VillageWorkforceViewModelMapper.MapFailure(status, Language);
        _mappedLanguage = Language;
    }

    private void SetInspectionCancelled()
    {
        _noticeStatus = null;
        _noticeWasCancelled = true;
        _notice = CancelledNotice();
        _mappedLanguage = Language;
    }

    private void RemapNotices()
    {
        if (_targetNoticeStatus is { } targetStatus)
        {
            _targetNotice = VillageWorkforceViewModelMapper
                .MapDiscoveryFailure(targetStatus, Language);
        }
        else if (_targetNoticeWasCancelled)
        {
            _targetNotice = CancelledNotice();
        }

        if (_noticeStatus is { } status)
        {
            _notice = VillageWorkforceViewModelMapper.MapFailure(
                status,
                Language);
        }
        else if (_noticeWasCancelled)
        {
            _notice = CancelledNotice();
        }
    }

    private VillageWorkforceNoticeViewModel CancelledNotice() => new(
        Text(VillageWorkforceUiTextKey.CancelledTitle),
        Text(VillageWorkforceUiTextKey.CancelledMessage),
        CanRetry: true);

    private string Text(VillageWorkforceUiTextKey key) =>
        VillageWorkforceUiText.Get(Language, key);

    public ValueTask DisposeAsync()
    {
        _lifetimeCancellation.Cancel();
        _requestCancellation?.Cancel();
        _requestCancellation?.Dispose();
        _lifetimeCancellation.Dispose();
        return ValueTask.CompletedTask;
    }
}
