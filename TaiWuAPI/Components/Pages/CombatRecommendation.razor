@page "/"
@implements IAsyncDisposable
@using Microsoft.Extensions.Options
@using Microsoft.JSInterop
@using TaiWu.Application.CombatRecommendations
@using TaiWu.Application.TacticalCombat
@using TaiWu.Application.TargetObservations
@using TaiWu.Application.Targets
@using TaiWu.Domain.CombatRecommendations
@using TaiWu.Domain.CombatSnapshots
@using TaiWuAPI.Configuration
@using TaiWuAPI.Contracts.CombatRecommendations
@using TaiWuAPI.Presentation
@inject IFindTargets FindTargets
@inject IRecommendTacticalCombat RecommendTacticalCombat
@inject ITargetObservationRecommendationWorkflow TargetObservationWorkflow
@inject IOptions<SaveGameOptions> SaveOptions
@inject ILogger<CombatRecommendation> Logger
@inject IJSRuntime JS

<PageTitle>TaiWu Helper · @T("Combat recommendation")</PageTitle>

<section class="hero">
    <div>
        <p class="eyebrow">@T("Read-only combat planning")</p>
        <h1>@T("Prepare for the fight before it starts.")</h1>
        <p class="hero-copy">
            @T("Search the configured save, choose a target and compare two evidence-backed loadout approaches. Every instruction is performed manually by you in the game.")
        </p>
    </div>
    <div class="boundary-card" role="note">
        <strong>@T("Information only")</strong>
        <span>@T("TaiWu Helper cannot change the save, equip skills, or control the game.")</span>
    </div>
</section>

<section class="control-panel"
         aria-labelledby="recommendation-controls"
         aria-busy="@IsBusy.ToString().ToLowerInvariant()">
    <div class="section-heading">
        <div>
            <p class="eyebrow">@T("Recommendation controls")</p>
            <h2 id="recommendation-controls">@T("Choose the encounter")</h2>
        </div>
        @if (_isSearching || _isRecommending)
        {
            <span class="working-status" role="status">@T("Reading the configured save…")</span>
        }
    </div>

    <div class="control-grid">
        <div class="control-group target-control">
            <label for="target-search">@T("Target name")</label>
            <div class="inline-control">
                <input id="target-search"
                       @bind="_targetQuery"
                       @bind:event="oninput"
                       placeholder="@T("Enter the in-game character name")"
                       autocomplete="off" />
                <button type="button"
                        class="secondary-button"
                        @onclick="SearchTargetsAsync"
                        disabled="@(!_configurationValid || IsBusy || string.IsNullOrWhiteSpace(_targetQuery))">
                    @T("Search")
                </button>
            </div>

            @if (_targetMatches.Count > 0)
            {
                <div class="target-results" aria-label="@T("Target search results")">
                    @foreach (var target in _targetMatches)
                    {
                        <button type="button"
                                class="@TargetResultClass(target.CharacterId)"
                                @onclick="() => SelectTarget(target)">
                            <strong class="target-result-name">
                                @target.DisplayName
                                @if (target.Kind == TargetLookupKind.StoryCharacter)
                                {
                                    <em>@T("Story character")</em>
                                }
                            </strong>
                            <span>@target.Age @T("years")</span>
                            <small>@LocationName(target)</small>
                        </button>
                    }
                </div>
            }
        </div>

        <div class="control-group">
            <label for="style-select">@T("Preferred style")</label>
            <select id="style-select"
                    @bind="_form.Policy"
                    @bind:after="MarkTacticalDraftStale">
                @foreach (var policy in RecommendationPolicyDisplay.VisiblePolicies)
                {
                    <option value="@policy">@PolicyLabel(policy)</option>
                }
            </select>
            <small>@T("Safe prioritizes survival; Aggressive accepts more risk.")</small>
        </div>

        <div class="control-group">
            <label for="weapon-select">@T("Preferred weapon (optional)")</label>
            <select id="weapon-select" @bind="_form.PreferredWeapon">
                <option value="">@T("No preference")</option>
                <option value="刀">刀</option>
            </select>
            <small>
                @T("A visible player preference only; verified rules still decide whether a loadout is feasible.")
            </small>
        </div>
    </div>

    <details class="observation-panel">
        <summary>@T("Optional current-screen observation")</summary>
        <p>
            @T("Analysis input only. These values refine this recommendation and are never sent to or applied in the game.")
        </p>
        <label class="check-control">
            <input type="checkbox"
                   @bind="_form.IncludeObservation"
                   @bind:after="MarkTacticalDraftStale"
                   disabled="@(_observationSkills.Count == 0)" />
            @T("Use selected equipped-skill names")
        </label>

        @if (_observationSkills.Count == 0)
        {
            <p>@T("Get an initial recommendation to load available skill names.")</p>
        }
        else if (_form.IncludeObservation)
        {
            <div class="observation-grid">
                @foreach (var group in _observationSkills
                    .GroupBy(skill => skill.Category)
                    .OrderBy(group => group.Key))
                {
                    <fieldset>
                        <legend>@CategoryName(group.Key)</legend>
                        @foreach (var skill in group.OrderBy(skill => skill.Name))
                        {
                            <label class="check-control">
                                <input type="checkbox"
                                       checked="@_form.EquippedSkillIds.Contains(skill.SkillId)"
                                       @onchange="() => ToggleObservationSkill(skill.SkillId)" />
                                @skill.Name
                            </label>
                        }
                    </fieldset>
                }
            </div>
            <div class="generic-grid">
                <label>
                    萬用 @T("total")
                    <input type="number" min="0"
                           @bind="_form.GenericTotal"
                           @bind:after="MarkTacticalDraftStale" />
                </label>
                <label>
                    摧破
                    <input type="number" min="0"
                           @bind="_form.GenericAttack"
                           @bind:after="MarkTacticalDraftStale" />
                </label>
                <label>
                    輕靈
                    <input type="number" min="0"
                           @bind="_form.GenericAgility"
                           @bind:after="MarkTacticalDraftStale" />
                </label>
                <label>
                    護體
                    <input type="number" min="0"
                           @bind="_form.GenericDefense"
                           @bind:after="MarkTacticalDraftStale" />
                </label>
                <label>
                    奇竅
                    <input type="number" min="0"
                           @bind="_form.GenericAssistance"
                           @bind:after="MarkTacticalDraftStale" />
                </label>
            </div>
        }
    </details>

    <TargetObservationForm State="_targetObservation"
                           Target="_selectedTarget"
                           Recommendation="_model"
                           Language="Language"
                           Busy="IsBusy"
                           DraftChanged="MarkTacticalDraftStale"
                           ApplyRequested="ApplyTargetObservationAsync"
                           ClearRequested="ClearTargetObservationAsync" />

    @if (_model?.TargetObservationImpact is not null)
    {
        <TargetObservationImpactPanel Impact="_model.TargetObservationImpact"
                                      Language="Language" />
    }

    <div class="request-row">
        <div>
            @if (_selectedTarget is not null)
            {
                <strong>
                    @T("Selected"): @_selectedTarget.DisplayName
                    @if (_selectedTarget.Kind == TargetLookupKind.StoryCharacter)
                    {
                        <em class="target-kind-badge">@T("Story character")</em>
                    }
                </strong>
                <span>@_selectedTarget.Age @T("years") · @LocationName(_selectedTarget)</span>
            }
            else
            {
                <span>@T("Select a target before requesting a recommendation.")</span>
            }
        </div>
        <button type="button"
                class="primary-button"
                @onclick="GetRecommendationAsync"
                disabled="@(!_configurationValid || _selectedTarget is null || IsBusy)">
            @(_isRecommending ? T("Calculating…") : T("Get recommendation"))
        </button>
    </div>
</section>

<PageStateNotice State="_pageState"
                 RetryRead="RetryLastReadAsync"
                 RetryDisabled="IsBusy" />

@if (_model is null
    && _tacticalSurfaceState != TacticalPlanSurfaceState.Unavailable)
{
    <TacticalCombatPlan Model="_tacticalModel"
                        SurfaceState="EffectiveTacticalSurfaceState"
                        Language="Language" />
}

@if (_model is not null)
{
    <section class="snapshot-strip" aria-label="@T("Snapshot metadata")">
        <div>
            <span>@T("Snapshot read")</span>
            <strong>@_model.CapturedAtUtc.ToLocalTime().ToString("g")</strong>
        </div>
        <div>
            <span>@T("Source freshness")</span>
            <strong>@FreshnessText(_model)</strong>
        </div>
        <div>
            <span>GameData</span>
            <strong>@(_model.GameDataVersion ?? T("Unavailable"))</strong>
        </div>
        <div>
            <span>@T("Weapon preference")</span>
            <strong>@(string.IsNullOrWhiteSpace(_form.PreferredWeapon) ? T("None") : _form.PreferredWeapon)</strong>
        </div>
        @if (_model.InnerPowerState is not null)
        {
            <div title="@_model.InnerPowerState.EffectDescription">
                <span>@T("Current inner-power state")</span>
                <strong>@_model.InnerPowerState.Name</strong>
                <small>@T("Applied to actively cast skills; equipping Neigong alone is not treated as a cast.")</small>
            </div>
        }
    </section>

    @if (_model.Warnings.Count > 0)
    {
        <WarningBanner Warnings="_model.Warnings" />
    }

    <section class="result-shell">
        <h2 class="visually-hidden">@T("Recommendation ready")</h2>

        @if (_model.TargetStrategy is not null)
        {
            <TargetStrategyPanel Strategy="_model.TargetStrategy"
                                 Language="Language"
                                 ThreatSelected="SelectThreat" />
        }

        <div class="style-tabs" role="group" aria-label="@T("Recommendation styles")">
            @foreach (var style in _model.Styles.Where(style =>
                RecommendationPolicyDisplay.IsVisible(style.Style)))
            {
                var selected = style.Style == _selection.VisibleStyle;
                <button type="button"
                        aria-pressed="@selected"
                        class="@(selected ? "active" : null)"
                        @onclick="() => ShowStyle(style.Style)">
                    <span>@PolicyLabel(style.Style)</span>
                    @if (selected)
                    {
                        <small>@T("Selected")</small>
                    }
                </button>
            }
        </div>

        @if (_tacticalModel is not null
            || _tacticalSurfaceState != TacticalPlanSurfaceState.Unavailable)
        {
            <TacticalCombatPlan Model="_tacticalModel"
                                SurfaceState="EffectiveTacticalSurfaceState"
                                Language="Language" />
        }

        @if (_model.Comparison is not null)
        {
            <LoadoutComparisonMatrix Comparison="_model.Comparison"
                                     SelectedPolicy="_selection.VisibleStyle"
                                     Language="Language"
                                     FilterState="_comparisonFilter"
                                     PolicySelected="ShowStyle"
                                     ThreatSelected="SelectThreat" />
        }

        @{
            var visible = _selection.VisibleRecommendation!;
        }
        <div class="@(_model.Threats.Count > 0
            ? "briefing-grid"
            : "briefing-grid briefing-grid-single")">
            @if (_model.Threats.Count > 0)
            {
                <ThreatPanel Threats="_model.Threats"
                             SelectedReference="_selection.SelectedThreatReference"
                             SelectedReferenceChanged="SelectThreat" />
            }

            <section class="loadout-panel" aria-labelledby="recommended-loadout-heading">
                <div class="panel-heading">
                    <div>
                        <p class="eyebrow">@T("Manual configuration")</p>
                        <h3 id="recommended-loadout-heading">@T("Skill details")</h3>
                    </div>
                </div>

                @if (visible.HasRecommendation)
                {
                    <details class="loadout-detail-disclosure">
                        <summary>
                            @T("Show detailed skill cards")
                            <span>
                                @visible.Categories.Sum(category => category.Skills.Count)
                                @T("skill(s)")
                            </span>
                        </summary>
                        <div class="loadout-detail-content">
                            @foreach (var category in visible.Categories)
                            {
                                <LoadoutCategory Category="category"
                                                 ManualChanges="visible.ManualChanges"
                                                 SelectedThreatReference="_selection.SelectedThreatReference" />
                            }
                        </div>
                    </details>
                }
                else
                {
                    <p class="empty-category">
                        @T(visible.Diagnostic ?? "No feasible recommendation was produced.")
                    </p>
                }
            </section>
        </div>

        @if (visible.HasRecommendation)
        {
            var checklist = ManualSetupChecklistBuilder.Build(visible);
            var battlePlan = BattlePlanViewModelBuilder.Build(visible);
            var supportingDetails =
                RecommendationSupportingDetailsBuilder.Build(_model, visible);
            <div class="manual-plan-grid">
                <ManualChecklist Items="checklist" />
                <BattlePlan Phases="battlePlan"
                            SelectedThreatReference="_selection.SelectedThreatReference" />
            </div>
            <SupportingDetails Details="supportingDetails" />
        }
    </section>
}

@code {
    private readonly RecommendationForm _form = new();
    private readonly List<TargetLookupEntry> _targetMatches = [];
    private readonly List<ObservationSkillOption> _observationSkills = [];
    private readonly RecommendationSelectionState _selection = new();
    private readonly LoadoutComparisonFilterState _comparisonFilter = new();
    private readonly TargetObservationEditorState _targetObservation = new();
    private CancellationTokenSource? _searchCancellation;
    private CancellationTokenSource? _recommendationCancellation;
    private string _targetQuery = string.Empty;
    private string _saveFilePath = string.Empty;
    private TargetLookupEntry? _selectedTarget;
    private CombatRecommendationViewModel? _model;
    private TacticalCombatViewModel? _tacticalModel;
    private TacticalPlanSurfaceState _tacticalSurfaceState =
        TacticalPlanSurfaceState.Unavailable;
    private int? _tacticalTargetCharacterId;
    private RecommendationPageState _pageState =
        RecommendationPageState.Initial();
    private PageReadOperation _lastReadOperation;
    private bool _configurationValid;
    private bool _isSearching;
    private bool _isRecommending;
    private long _searchVersion;
    private long _recommendationVersion;
    private TaiwuLanguage? _lastLanguage;
    private string? _pendingFocusId;

    [CascadingParameter]
    public TaiwuLanguage Language { get; set; } = TaiwuLanguage.English;

    private bool IsBusy => _isSearching || _isRecommending;

    private TacticalPlanSurfaceState EffectiveTacticalSurfaceState =>
        _tacticalModel is not null
            && (_isRecommending
                || _selectedTarget?.CharacterId
                    != _tacticalTargetCharacterId
                || _form.Policy != _tacticalModel.Policy)
            ? TacticalPlanSurfaceState.PreviousResult
            : _tacticalSurfaceState;

    protected override void OnInitialized()
    {
        try
        {
            _saveFilePath = SaveOptions.Value.DefaultSaveFilePath;
            _configurationValid = true;
        }
        catch (OptionsValidationException)
        {
            _configurationValid = false;
            _pageState = RecommendationPageState.InvalidConfiguration();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_lastLanguage is null)
        {
            _lastLanguage = Language;
            return;
        }

        if (_lastLanguage == Language)
        {
            return;
        }

        _lastLanguage = Language;
        var selectedCharacterId = _selectedTarget?.CharacterId;
        var hadRecommendation = _model is not null;
        var visibleStyle = _selection.VisibleStyle;
        var selectedThreatReference = _selection.SelectedThreatReference;
        if (!_configurationValid
            || !selectedCharacterId.HasValue)
        {
            _pageState = RecommendationPageState.Initial();
            return;
        }

        await SearchTargetsAsync(selectedCharacterId.Value.ToString());

        var translatedTarget = _targetMatches.FirstOrDefault(target =>
            target.CharacterId == selectedCharacterId.Value);
        if (translatedTarget is null)
        {
            return;
        }

        SelectTarget(translatedTarget);
        if (hadRecommendation)
        {
            await GetRecommendationAsync();
            if (_model?.Comparison is not null)
            {
                _comparisonFilter.LoadComparison(
                    _model.Comparison.Reference,
                    preserveMode: true);
                _selection.RestoreInteraction(
                    visibleStyle,
                    selectedThreatReference);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingFocusId is null)
        {
            return;
        }

        var focusId = _pendingFocusId;
        _pendingFocusId = null;
        try
        {
            await JS.InvokeVoidAsync("taiwuHelper.focusElement", focusId);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private Task SearchTargetsAsync() => SearchTargetsAsync(_targetQuery);

    private async Task SearchTargetsAsync(string query)
    {
        if (!_configurationValid || string.IsNullOrWhiteSpace(query))
        {
            return;
        }

        var version = ++_searchVersion;
        var cancellation = ReplaceCancellation(ref _searchCancellation);
        _lastReadOperation = PageReadOperation.TargetSearch;
        _isSearching = true;
        _selectedTarget = null;
        _targetMatches.Clear();
        _model = null;
        ResetTacticalResult();
        ResetObservation();
        _targetObservation.ResetForTarget();
        _selection.Clear();
        _pageState = RecommendationPageState.Loading(
            "Searching the configured save");

        try
        {
            var result = await FindTargets.ExecuteAsync(
                new FindTargetsRequest(
                    _saveFilePath,
                    query,
                    language: Language),
                cancellation.Token);
            if (version != _searchVersion)
            {
                return;
            }

            _targetMatches.AddRange(result.Matches);
            _pageState = RecommendationPageState.ForTargetLookup(
                result.Status,
                result.TotalMatches);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
            when (exception is ArgumentException
                  or FileNotFoundException
                  or InvalidDataException)
        {
            _pageState = RecommendationPageState.Failure(
                "The target search could not read valid data from the "
                + "configured save.");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Unexpected target lookup failure.");
            _pageState = RecommendationPageState.Failure(
                "An unexpected target read failure occurred.");
        }
        finally
        {
            if (version == _searchVersion)
            {
                _isSearching = false;
            }
        }
    }

    private void SelectTarget(TargetLookupEntry target)
    {
        _selectedTarget = target;
        _targetQuery = target.DisplayName;
        _model = null;
        ResetTacticalResult();
        ResetObservation();
        _targetObservation.ResetForTarget();
        _selection.Clear();
        _lastReadOperation = PageReadOperation.None;
        _pageState = RecommendationPageState.TargetReady(
            target.DisplayName);
    }

    private Task GetRecommendationAsync() => GetRecommendationAsync(
        preserveClearedTargetObservation: false);

    private async Task GetRecommendationAsync(
        bool preserveClearedTargetObservation)
    {
        if (!_configurationValid || _selectedTarget is null)
        {
            return;
        }

        var version = ++_recommendationVersion;
        var cancellation = ReplaceCancellation(
            ref _recommendationCancellation);
        _lastReadOperation = PageReadOperation.Recommendation;
        _isRecommending = true;
        if (!preserveClearedTargetObservation)
        {
            _targetObservation.ResetForTarget();
        }
        _tacticalSurfaceState = _tacticalModel is null
            ? TacticalPlanSurfaceState.Loading
            : TacticalPlanSurfaceState.PreviousResult;
        if (_model is null)
        {
            _selection.Clear();
        }
        _pageState = RecommendationPageState.Loading(
            "Building the combat recommendation");

        try
        {
            var observation = CreateObservation();
            var tactical = await RecommendTacticalCombat.ExecuteAsync(
                new TacticalPlanningApiRequest().ToApplication(
                    _saveFilePath,
                    _selectedTarget.CharacterId,
                    _form.Policy,
                    observation,
                    Language),
                cancellation.Token);
            if (version != _recommendationVersion)
            {
                return;
            }

            var recommendation = tactical.LegacyRecommendation
                ?? throw new InvalidDataException(
                    "The coherent tactical result has no legacy recommendation.");
            var tacticalModel = TacticalCombatViewModelMapper.Map(tactical);
            _model = CombatRecommendationViewModelMapper.Map(
                recommendation,
                Language);
            _tacticalModel = tacticalModel;
            _tacticalTargetCharacterId = _selectedTarget.CharacterId;
            _tacticalSurfaceState = TacticalPlanSurfaceState.Ready;
            _pendingFocusId = "tactical-plan-heading";
            PopulateObservationSkills(_model);
            _selection.Load(_model, _form.Policy);
            _pageState =
                RecommendationPageState.ForRecommendation(_model);
        }
        catch (OperationCanceledException)
        {
            if (version == _recommendationVersion)
            {
                _tacticalSurfaceState = TacticalPlanSurfaceState.Cancelled;
            }
        }
        catch (Exception exception)
            when (exception is ArgumentException
                  or FileNotFoundException
                  or InvalidDataException
                  or FormatException
                  or OverflowException)
        {
            _tacticalSurfaceState = TacticalPlanSurfaceState.Failure;
            _pageState = RecommendationPageState.Failure(
                "The recommendation could not be built from the available "
                + "save data.");
        }
        catch (Exception exception)
        {
            _tacticalSurfaceState = TacticalPlanSurfaceState.Failure;
            Logger.LogError(
                exception,
                "Unexpected combat recommendation failure.");
            _pageState = RecommendationPageState.Failure(
                "An unexpected recommendation read or calculation failure "
                + "occurred.");
        }
        finally
        {
            if (version == _recommendationVersion)
            {
                _isRecommending = false;
            }
        }
    }

    private async Task ApplyTargetObservationAsync(
        TargetObservationRequest observation)
    {
        if (!_configurationValid || _selectedTarget is null || _model is null)
        {
            _targetObservation.MarkError("OBSERVATION_APPLY_FAILED");
            return;
        }

        var version = ++_recommendationVersion;
        var cancellation = ReplaceCancellation(
            ref _recommendationCancellation);
        _lastReadOperation = PageReadOperation.Recommendation;
        _isRecommending = true;
        _tacticalSurfaceState = _tacticalModel is null
            ? TacticalPlanSurfaceState.Loading
            : TacticalPlanSurfaceState.PreviousResult;
        _pageState = RecommendationPageState.Loading(
            "Building the combat recommendation");

        try
        {
            var recommendation = await TargetObservationWorkflow.ExecuteAsync(
                new RecommendCombatLoadoutRequest(
                    _saveFilePath,
                    _selectedTarget.CharacterId,
                    _form.Policy,
                    CreateObservation(),
                    Language,
                    observation),
                cancellation.Token);
            if (version != _recommendationVersion)
            {
                return;
            }

            var processing = recommendation.TargetObservation
                ?? throw new InvalidDataException(
                    "Target observation result is unavailable.");
            _targetObservation.MarkResult(processing.Merge);
            _model = CombatRecommendationViewModelMapper.Map(
                recommendation,
                Language);
            _tacticalModel = null;
            _tacticalTargetCharacterId = null;
            _tacticalSurfaceState =
                TacticalPlanSurfaceState.ObservationReplaced;
            PopulateObservationSkills(_model);
            _selection.Load(_model, _form.Policy);
            _pageState = RecommendationPageState.ForRecommendation(_model);
        }
        catch (OperationCanceledException)
        {
            if (version == _recommendationVersion)
            {
                _tacticalSurfaceState = TacticalPlanSurfaceState.Cancelled;
            }
        }
        catch (Exception exception)
            when (exception is ArgumentException
                or FileNotFoundException
                or InvalidDataException
                or TargetObservationResolutionException)
        {
            _tacticalSurfaceState = TacticalPlanSurfaceState.Failure;
            _targetObservation.MarkError("OBSERVATION_APPLY_FAILED");
            _pageState = RecommendationPageState.Failure(
                "The recommendation could not be built from the available "
                + "save data.");
        }
        catch (Exception exception)
        {
            _tacticalSurfaceState = TacticalPlanSurfaceState.Failure;
            Logger.LogError(
                exception,
                "Unexpected target-observation recommendation failure.");
            _targetObservation.MarkError("OBSERVATION_APPLY_FAILED");
            _pageState = RecommendationPageState.Failure(
                "An unexpected recommendation read or calculation failure "
                + "occurred.");
        }
        finally
        {
            if (version == _recommendationVersion)
            {
                _isRecommending = false;
            }
        }
    }

    private Task ClearTargetObservationAsync() =>
        _selectedTarget is null || _model is null
            ? Task.CompletedTask
            : GetRecommendationAsync(
                preserveClearedTargetObservation: true);

    private Task RetryLastReadAsync() => _lastReadOperation switch
    {
        PageReadOperation.TargetSearch => SearchTargetsAsync(),
        PageReadOperation.Recommendation => GetRecommendationAsync(),
        _ => Task.CompletedTask
    };

    private PlayerLoadoutObservation? CreateObservation()
    {
        if (!_form.IncludeObservation)
        {
            return null;
        }

        return new PlayerLoadoutObservation(
            DateTimeOffset.UtcNow,
            "ui:manual-current-screen-observation",
            new CombatLoadoutSnapshot(
                ObservedSkillIds(SkillCategory.Neigong),
                ObservedSkillIds(SkillCategory.Attack),
                ObservedSkillIds(SkillCategory.Agility),
                ObservedSkillIds(SkillCategory.Defense),
                ObservedSkillIds(SkillCategory.Assistance)),
            new GenericSlotAllocation(
                _form.GenericTotal,
                _form.GenericAttack,
                _form.GenericAgility,
                _form.GenericDefense,
                _form.GenericAssistance));
    }

    private int[] ObservedSkillIds(SkillCategory category) =>
        _observationSkills
            .Where(skill => skill.Category == category)
            .Where(skill => _form.EquippedSkillIds.Contains(skill.SkillId))
            .Select(skill => skill.SkillId)
            .ToArray();

    private void ToggleObservationSkill(int skillId)
    {
        if (!_form.EquippedSkillIds.Add(skillId))
        {
            _form.EquippedSkillIds.Remove(skillId);
        }

        MarkTacticalDraftStale();
    }

    private void PopulateObservationSkills(CombatRecommendationViewModel model)
    {
        var available = model.Styles
            .Where(style =>
                RecommendationPolicyDisplay.IsVisible(style.Style))
            .SelectMany(style => style.Categories)
            .SelectMany(category => category.Skills)
            .GroupBy(skill => skill.SkillId)
            .Select(group => group.First())
            .OrderBy(skill => skill.Category)
            .ThenBy(skill => skill.Name, StringComparer.Ordinal)
            .Select(skill => new ObservationSkillOption(
                skill.SkillId,
                skill.Name ?? T("Unnamed skill"),
                skill.Category))
            .ToArray();
        _observationSkills.Clear();
        _observationSkills.AddRange(available);
        _form.EquippedSkillIds.RemoveWhere(skillId =>
            available.All(skill => skill.SkillId != skillId));
    }

    private void ResetObservation()
    {
        _observationSkills.Clear();
        _form.IncludeObservation = false;
        _form.EquippedSkillIds.Clear();
    }

    private void ResetTacticalResult()
    {
        _tacticalModel = null;
        _tacticalTargetCharacterId = null;
        _tacticalSurfaceState = TacticalPlanSurfaceState.Unavailable;
    }

    private void MarkTacticalDraftStale()
    {
        if (_tacticalModel is not null)
        {
            _tacticalSurfaceState = TacticalPlanSurfaceState.PreviousResult;
        }
    }

    private string TargetResultClass(int characterId) =>
        _selectedTarget?.CharacterId == characterId
            ? "target-result selected"
            : "target-result";

    private string LocationName(TargetLookupEntry target)
    {
        if (target.LocationDisplayName is not null)
        {
            return target.LocationDisplayName;
        }

        if (target.HasValidLocation)
        {
            return $"{T("Area")} {target.AreaId} · "
                + $"{T("Block")} {target.BlockId}";
        }

        return target.Kind == TargetLookupKind.StoryCharacter
            ? T("Not currently placed on the map")
            : T("Location unavailable");
    }

    private string CategoryName(SkillCategory category) => category switch
    {
        SkillCategory.Neigong => "內功",
        SkillCategory.Attack => "摧破",
        SkillCategory.Agility => "輕靈",
        SkillCategory.Defense => "護體",
        SkillCategory.Assistance => "奇竅",
        _ => T("Unavailable")
    };

    private void ShowStyle(RecommendationPolicy style)
    {
        _selection.ShowStyle(style);
    }

    private void SelectThreat(string? threatReference)
    {
        _selection.SelectThreat(threatReference);
    }

    private string FreshnessText(CombatRecommendationViewModel model)
    {
        if (!model.SaveLastWriteTimeUtc.HasValue)
        {
            return T("Unavailable");
        }

        var age = model.CapturedAtUtc - model.SaveLastWriteTimeUtc.Value;
        if (age < TimeSpan.Zero)
        {
            return T("Source timestamp is newer than the read");
        }

        if (age <= TimeSpan.FromMinutes(15))
        {
            var minutes = Math.Max(0, age.TotalMinutes);
            return Language == TaiwuLanguage.Chinese
                ? $"讀取時為 {minutes:0} 分鐘前"
                : $"{minutes:0} min old at read";
        }

        if (age < TimeSpan.FromHours(2))
        {
            return Language == TaiwuLanguage.Chinese
                ? $"讀取時為 {age.TotalMinutes:0} 分鐘前"
                : $"{age.TotalMinutes:0} min old at read";
        }

        return Language == TaiwuLanguage.Chinese
            ? $"讀取時為 {age.TotalHours:0.0} 小時前"
            : $"{age.TotalHours:0.0} h old at read";
    }

    private string T(string english) => UiText.Get(Language, english);

    private string PolicyLabel(RecommendationPolicy policy) => policy switch
    {
        RecommendationPolicy.Safe => T("Safe"),
        RecommendationPolicy.Balanced => T("Balanced"),
        RecommendationPolicy.Aggressive => T("Aggressive"),
        _ => policy.ToString()
    };

    private static CancellationTokenSource ReplaceCancellation(
        ref CancellationTokenSource? cancellation)
    {
        cancellation?.Cancel();
        cancellation?.Dispose();
        cancellation = new CancellationTokenSource();
        return cancellation;
    }

    public ValueTask DisposeAsync()
    {
        _searchCancellation?.Cancel();
        _searchCancellation?.Dispose();
        _recommendationCancellation?.Cancel();
        _recommendationCancellation?.Dispose();
        return ValueTask.CompletedTask;
    }

    private sealed class RecommendationForm
    {
        public RecommendationPolicy Policy { get; set; } =
            RecommendationPolicy.Safe;

        public string PreferredWeapon { get; set; } = string.Empty;

        public bool IncludeObservation { get; set; }

        public HashSet<int> EquippedSkillIds { get; } = [];

        public int GenericTotal { get; set; }

        public int GenericAttack { get; set; }

        public int GenericAgility { get; set; }

        public int GenericDefense { get; set; }

        public int GenericAssistance { get; set; }
    }

    private sealed record ObservationSkillOption(
        int SkillId,
        string Name,
        SkillCategory Category);

    private enum PageReadOperation
    {
        None,
        TargetSearch,
        Recommendation
    }
