@using TaiWu.Domain.CombatRecommendations
@using TaiWu.Domain.CombatSnapshots
@using TaiWu.Domain.LoadoutComparisons
@using TaiWuAPI.Presentation

<section class="@SectionClass"
         aria-labelledby="loadout-comparison-heading"
         data-comparison-reference="@Comparison.Reference"
         data-selected-policy="@SelectedPolicy">
    <div class="comparison-heading">
        <div>
            <p class="eyebrow">@T("Same snapshot · exact manual changes")</p>
            <h3 id="loadout-comparison-heading" tabindex="-1">
                @T("Loadout comparison")
            </h3>
        </div>
    </div>

    <div class="comparison-provenance" role="note"
         aria-label="@T("Current baseline provenance")">
        <strong>@T("Current baseline provenance")</strong>
        <dl>
            @foreach (var group in Comparison.BaselineProvenance.GroupBy(value =>
                new { value.Source, value.CapturedAtUtc }))
            {
                <div>
                    <dt>@string.Join(", ", group.Select(value =>
                        ProvenanceFieldLabel(value.Field)))</dt>
                    <dd>
                        @ProvenanceSourceLabel(group.Key.Source)
                        <small>@group.Key.CapturedAtUtc.ToLocalTime().ToString("g")</small>
                    </dd>
                </div>
            }
        </dl>
    </div>

    <div class="comparison-controls">
        <div class="comparison-filter" role="group"
             aria-label="@T("Comparison rows")">
            <button type="button"
                    aria-pressed="@(!FilterState.DifferencesOnly)"
                    class="@(!FilterState.DifferencesOnly ? "active" : null)"
                    @onclick="() => SetDifferencesOnly(false)">
                @T("All rows")
            </button>
            <button type="button"
                    aria-pressed="@FilterState.DifferencesOnly"
                    class="@(FilterState.DifferencesOnly ? "active" : null)"
                    @onclick="() => SetDifferencesOnly(true)">
                @T("Differences only")
            </button>
        </div>
        <span class="comparison-row-status comparison-row-status-desktop"
              role="status"
              aria-live="polite">
            @FilterLabel: @VisibleRowCount @T("skill row(s) shown")
        </span>
        <span class="comparison-row-status comparison-row-status-narrow"
              role="status"
              aria-live="polite">
            @PolicyLabel(SelectedPolicy): @FilterLabel:
            @SelectedVisibleRowCount @T("skill row(s) shown")
        </span>
    </div>

    <nav class="comparison-category-navigation"
         aria-label="@T("Comparison categories")">
        <a href="#loadout-comparison-heading">@T("All categories")</a>
        @foreach (var category in Comparison.Categories)
        {
            <a href="@CategoryHref(category.Category)">
                @category.DisplayName
            </a>
        }
    </nav>

    <a class="comparison-skip-link"
       href="@CategoryHref(Comparison.Categories[0].Category)">
        @T("Skip to comparison categories")
    </a>

    <div class="comparison-table-scroll" tabindex="0"
         aria-label="@T("Scrollable loadout comparison")">
        <table class="comparison-table">
            <caption class="visually-hidden">
                @T("Current loadout compared with Safe and Aggressive policy winners.")
            </caption>
            <thead>
                <tr>
                    <th scope="col">@T("Category and skill")</th>
                    @foreach (var column in VisibleColumns)
                    {
                        <th scope="col"
                            class="@ColumnClass(column)"
                            data-column="@column.Kind">
                            <strong>@ColumnLabel(column)</strong>
                            <small>@ColumnStatusLabel(column)</small>
                            @if (column.GenericSlots is not null)
                            {
                                <span class="comparison-generic">
                                    萬用 @GenericLabel(column.GenericSlots)
                                    @if (column.GenericSlotsChanged)
                                    {
                                        <em>@T("Allocation change")</em>
                                    }
                                </span>
                            }
                            @if (!string.IsNullOrWhiteSpace(column.Diagnostic))
                            {
                                <span class="comparison-diagnostic" role="note">
                                    @T(column.Diagnostic)
                                </span>
                            }
                            else if (!string.IsNullOrWhiteSpace(
                                column.ManualActionCountUnavailableReason))
                            {
                                <span class="comparison-diagnostic" role="note">
                                    @T(column.ManualActionCountUnavailableReason)
                                </span>
                            }
                            @if (column.Policy.HasValue
                                && column.Status
                                    == LoadoutComparisonColumnStatus.Available)
                            {
                                <a href="#manual-checklist-heading"
                                   @onclick="() => SelectPolicyAsync(column.Policy.Value)">
                                    @T("View setup checklist and battle plan")
                                </a>
                            }
                        </th>
                    }
                </tr>
            </thead>
            @foreach (var category in Comparison.Categories)
            {
                var visibleSkills = VisibleSkills(category).ToArray();
                <tbody aria-labelledby="@CategoryHeadingId(category.Category)">
                    <tr class="comparison-category-row">
                        <th id="@CategoryHeadingId(category.Category)"
                            scope="rowgroup"
                            tabindex="-1">
                            <strong>@category.DisplayName</strong>
                        </th>
                        @foreach (var column in VisibleColumns)
                        {
                            var capacity = CapacityFor(category, column.Kind);
                            <td class="comparison-capacity-cell @ColumnClass(column)"
                                aria-label="@CapacityAriaLabel(
                                    category,
                                    column,
                                    capacity)">
                                @if (capacity is null)
                                {
                                    <span>@T("Unavailable")</span>
                                    @if (!string.IsNullOrWhiteSpace(column.Diagnostic))
                                    {
                                        <small>@T(column.Diagnostic)</small>
                                    }
                                }
                                else
                                {
                                    <strong>@CapacityLabel(capacity)</strong>
                                    <span>@T("Remaining"): @ValueLabel(
                                        capacity.Remaining,
                                        capacity.RemainingUnavailableReason)</span>
                                    <span>萬用: @ValueLabel(
                                        capacity.GenericContribution,
                                        capacity.GenericContributionUnavailableReason)</span>
                                    @if (HasUnavailableCapacity(capacity))
                                    {
                                        <small>@CapacityUnavailableReason(capacity)</small>
                                    }
                                }
                            </td>
                        }
                    </tr>
                    @foreach (var skill in visibleSkills)
                    {
                        <tr class="@SkillRowClass(skill)"
                            data-skill-id="@skill.SkillId">
                            <th scope="row">
                                <strong>@(skill.Name ?? T("Unnamed skill"))</strong>
                                <small>@category.DisplayName</small>
                                @if (!string.IsNullOrWhiteSpace(
                                    skill.NameUnavailableReason))
                                {
                                    <span>@T(skill.NameUnavailableReason)</span>
                                }
                            </th>
                            @foreach (var column in VisibleColumns)
                            {
                                var cell = CellFor(skill, column.Kind);
                                <td class="comparison-skill-cell @ColumnClass(column)"
                                    aria-label="@SkillCellAriaLabel(
                                        category,
                                        skill,
                                        column,
                                        cell)">
                                    @if (column.Status
                                        != LoadoutComparisonColumnStatus.Available)
                                    {
                                        <span class="comparison-membership unavailable">
                                            <span aria-hidden="true">?</span>
                                            @ColumnStatusLabel(column)
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(
                                            column.Diagnostic))
                                        {
                                            <small class="comparison-unavailable">
                                                @T(column.Diagnostic)
                                            </small>
                                        }
                                    }
                                    else if (cell is null)
                                    {
                                        <span class="comparison-membership absent">
                                            <span aria-hidden="true">—</span>
                                            @AbsentLabel(column.Kind)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="@MembershipClass(cell)"
                                              data-membership="@cell.Membership">
                                            <span aria-hidden="true">@MembershipIcon(cell)</span>
                                            @MembershipLabel(cell)
                                        </span>
                                        <small>
                                            @T("Effective cost"):
                                            @ValueLabel(
                                                cell.EffectiveCost,
                                                cell.EffectiveCostUnavailableReason)
                                        </small>
                                        @if (cell.EffectiveCost is null
                                            && !string.IsNullOrWhiteSpace(
                                                cell.EffectiveCostUnavailableReason))
                                        {
                                            <small class="comparison-unavailable">
                                                @T(cell.EffectiveCostUnavailableReason)
                                            </small>
                                        }
                                        @if (cell.Actions.Count > 0)
                                        {
                                            <ul class="comparison-actions">
                                                @foreach (var action in cell.Actions)
                                                {
                                                    <li>
                                                        <strong>@ActionLabel(action)</strong>
                                                        <span>@T(action.Reason)</span>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(
                                            cell.MembershipUnavailableReason))
                                        {
                                            <small class="comparison-unavailable">
                                                @T(cell.MembershipUnavailableReason)
                                            </small>
                                        }
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            }
        </table>
    </div>

    <LoadoutComparisonTactics Comparison="Comparison"
                               SelectedPolicy="SelectedPolicy"
                               ThreatSelected="ThreatSelected"
                               Language="Language" />

    <div class="comparison-legend" role="note"
         aria-label="@T("Comparison status legend")">
        <strong>@T("Legend")</strong>
        <span><b aria-hidden="true">✓</b> @T("Retained")</span>
        <span><b aria-hidden="true">+</b> @T("Added")</span>
        <span><b aria-hidden="true">−</b> @T("Removed")</span>
        <span><b aria-hidden="true">⇄</b> @T("Direction change required")</span>
        <span><b aria-hidden="true">◇</b> @T("Breakthrough required")</span>
        <span><b aria-hidden="true">?</b> @T("Unavailable")</span>
    </div>

    <p class="comparison-boundary">@T(Comparison.InformationOnlyNotice)</p>
</section>

@code {
    private string? _comparisonReference;

    [Parameter, EditorRequired]
    public LoadoutComparisonViewModel Comparison { get; set; } = default!;

    [Parameter]
    public LoadoutComparisonFilterState FilterState { get; set; } = new();

    [Parameter]
    public EventCallback<RecommendationPolicy> PolicySelected { get; set; }

    [Parameter]
    public EventCallback<string?> ThreatSelected { get; set; }

    [Parameter]
    public RecommendationPolicy SelectedPolicy { get; set; } =
        RecommendationPolicy.Safe;

    [Parameter]
    public TaiwuLanguage Language { get; set; } = TaiwuLanguage.English;

    protected override void OnParametersSet()
    {
        if (!string.Equals(
                _comparisonReference,
                Comparison.Reference,
                StringComparison.Ordinal))
        {
            _comparisonReference = Comparison.Reference;
            FilterState.LoadComparison(_comparisonReference);
        }
    }

    private int VisibleRowCount => Comparison.Categories
        .Sum(category => VisibleSkills(category).Count());

    private IEnumerable<LoadoutComparisonColumnViewModel> VisibleColumns =>
        Comparison.Columns.Where(column =>
            !column.Policy.HasValue
            || RecommendationPolicyDisplay.IsVisible(column.Policy.Value));

    private int SelectedVisibleRowCount => Comparison.Categories.Sum(
        category => FilterState.DifferencesOnly
            ? category.Skills.Count(skill =>
                HasDifferenceForPolicy(skill, SelectedPolicy))
            : category.Skills.Count);

    private string FilterLabel => FilterState.DifferencesOnly
        ? T("Differences only")
        : T("All rows");

    private string SectionClass =>
        "loadout-comparison "
        + (FilterState.DifferencesOnly
            ? "comparison-differences-only "
            : "comparison-all-rows ")
        + $"comparison-selected-{PolicyCss(SelectedPolicy)}";

    private IEnumerable<LoadoutComparisonSkillRowViewModel> VisibleSkills(
        LoadoutComparisonCategoryViewModel category) =>
        FilterState.DifferencesOnly
            ? category.Skills.Where(skill => skill.Cells.Any(cell =>
                cell.Column != LoadoutComparisonColumnKind.Current
                && cell.Column != LoadoutComparisonColumnKind.Balanced
                && cell.HasDifference))
            : category.Skills;

    private void SetDifferencesOnly(bool value) =>
        FilterState.SetDifferencesOnly(value);

    private Task SelectPolicyAsync(RecommendationPolicy policy) =>
        PolicySelected.InvokeAsync(policy);

    private bool HasDifferenceForPolicy(
        LoadoutComparisonSkillRowViewModel skill,
        RecommendationPolicy policy)
    {
        var kind = PolicyColumn(policy);
        return skill.Cells.SingleOrDefault(cell => cell.Column == kind)
            ?.HasDifference == true;
    }

    private string SkillRowClass(
        LoadoutComparisonSkillRowViewModel skill)
    {
        var classes = new List<string> { "comparison-skill-row" };
        foreach (var policy in RecommendationPolicyDisplay.VisiblePolicies)
        {
            if (HasDifferenceForPolicy(skill, policy))
            {
                classes.Add($"comparison-difference-{PolicyCss(policy)}");
            }
        }

        return string.Join(' ', classes);
    }

    private string ColumnClass(LoadoutComparisonColumnViewModel column) =>
        "comparison-column "
        + (column.Kind == LoadoutComparisonColumnKind.Current
            ? "comparison-current-column"
            : "comparison-policy-column "
                + (column.Policy == SelectedPolicy
                    ? "comparison-selected-policy"
                    : "comparison-unselected-policy"));

    private static LoadoutComparisonCapacityCellViewModel? CapacityFor(
        LoadoutComparisonCategoryViewModel category,
        LoadoutComparisonColumnKind column) =>
        category.Capacities.SingleOrDefault(value => value.Column == column);

    private static LoadoutComparisonSkillCellViewModel? CellFor(
        LoadoutComparisonSkillRowViewModel skill,
        LoadoutComparisonColumnKind column) =>
        skill.Cells.SingleOrDefault(value => value.Column == column);

    private string ColumnLabel(LoadoutComparisonColumnViewModel column) =>
        LoadoutComparisonUiText.Column(column, Language);

    private string PolicyLabel(RecommendationPolicy policy) =>
        LoadoutComparisonUiText.Policy(policy, Language);

    private string ColumnStatusLabel(
        LoadoutComparisonColumnViewModel column) =>
        LoadoutComparisonUiText.ColumnStatus(column, Language);

    private string MembershipLabel(
        LoadoutComparisonSkillCellViewModel cell) => cell.Membership switch
        {
            LoadoutComparisonMembership.Present => T("Present"),
            LoadoutComparisonMembership.Retained => T("Retained"),
            LoadoutComparisonMembership.Added => T("Added"),
            LoadoutComparisonMembership.Removed => T("Removed"),
            null => T("Unavailable"),
            _ => T("Unavailable")
        };

    private static string MembershipIcon(
        LoadoutComparisonSkillCellViewModel cell) => cell.Membership switch
        {
            LoadoutComparisonMembership.Present => "●",
            LoadoutComparisonMembership.Retained => "✓",
            LoadoutComparisonMembership.Added => "+",
            LoadoutComparisonMembership.Removed => "−",
            _ => "?"
        };

    private static string MembershipClass(
        LoadoutComparisonSkillCellViewModel cell) =>
        "comparison-membership "
        + (cell.Membership?.ToString().ToLowerInvariant() ?? "unavailable");

    private string ActionLabel(
        LoadoutComparisonSkillActionViewModel action) => action.Kind switch
        {
            LoadoutComparisonSkillActionKind.DirectionChangeRequired =>
                $"⇄ {T("Change to")} {DirectionLabel(action.RequiredDirection)}",
            LoadoutComparisonSkillActionKind.BreakthroughRequired =>
                $"◇ {T("Complete")} {DirectionLabel(action.RequiredDirection)} "
                + T("breakthrough"),
            _ => T("Unavailable")
        };

    private string DirectionLabel(PracticeDirection direction) =>
        direction switch
        {
            PracticeDirection.Direct => Language == TaiwuLanguage.Chinese
                ? "正練"
                : "Direct",
            PracticeDirection.Reverse => Language == TaiwuLanguage.Chinese
                ? "逆練"
                : "Reverse",
            _ => T("Unavailable")
        };

    private string AbsentLabel(LoadoutComparisonColumnKind column) =>
        column == LoadoutComparisonColumnKind.Current
            ? T("Not equipped")
            : T("Not part of this policy");

    private string CapacityLabel(
        LoadoutComparisonCapacityCellViewModel capacity) =>
        $"{ValueLabel(capacity.Used, capacity.UsedUnavailableReason)} / "
        + ValueLabel(capacity.Capacity, capacity.CapacityUnavailableReason);

    private string ValueLabel(int? value, string? unavailableReason) =>
        value?.ToString() ?? (string.IsNullOrWhiteSpace(unavailableReason)
            ? T("Unavailable")
            : T("Unavailable"));

    private static bool HasUnavailableCapacity(
        LoadoutComparisonCapacityCellViewModel capacity) =>
        capacity.Used is null
        || capacity.Capacity is null
        || capacity.Remaining is null
        || capacity.GenericContribution is null;

    private string CapacityUnavailableReason(
        LoadoutComparisonCapacityCellViewModel capacity) => T(
        new[]
        {
            capacity.UsedUnavailableReason,
            capacity.CapacityUnavailableReason,
            capacity.RemainingUnavailableReason,
            capacity.GenericContributionUnavailableReason
        }.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))
        ?? "Unavailable");

    private static string GenericLabel(
        LoadoutComparisonGenericSlotsViewModel generic) =>
        $"{generic.Total} · 摧破 {generic.Attack} · 輕靈 {generic.Agility} · "
        + $"護體 {generic.Defense} · 奇竅 {generic.Assistance}";

    private string ProvenanceFieldLabel(
        LoadoutComparisonBaselineField field) => field switch
        {
            LoadoutComparisonBaselineField.EquippedSkills =>
                T("Equipped skills"),
            LoadoutComparisonBaselineField.GenericSlotAllocation => "萬用",
            LoadoutComparisonBaselineField.SlotBudgets => T("Slot budgets"),
            LoadoutComparisonBaselineField.LegendaryBookCostAssignments =>
                T("Legendary-book cost assignments"),
            _ => T("Unavailable")
        };

    private string ProvenanceSourceLabel(SnapshotDataSource source) =>
        source switch
        {
            SnapshotDataSource.Save => T("Save"),
            SnapshotDataSource.CurrentScreenObservation =>
                T("Current-screen observation"),
            SnapshotDataSource.GameConfiguration => T("Game configuration"),
            SnapshotDataSource.VerifiedRule => T("Verified rule"),
            _ => T("Unavailable")
        };

    private string CapacityAriaLabel(
        LoadoutComparisonCategoryViewModel category,
        LoadoutComparisonColumnViewModel column,
        LoadoutComparisonCapacityCellViewModel? capacity)
    {
        var prefix = $"{category.DisplayName}, {ColumnLabel(column)}";
        if (capacity is null)
        {
            return $"{prefix}. {ColumnStatusLabel(column)}. "
                + (string.IsNullOrWhiteSpace(column.Diagnostic)
                    ? T("Unavailable")
                    : T(column.Diagnostic));
        }

        var label = $"{prefix}. {T("Used capacity")} "
            + $"{ValueLabel(capacity.Used, capacity.UsedUnavailableReason)} "
            + $"{T("of")} "
            + $"{ValueLabel(capacity.Capacity, capacity.CapacityUnavailableReason)}. "
            + $"{T("Remaining")} "
            + $"{ValueLabel(capacity.Remaining, capacity.RemainingUnavailableReason)}. "
            + $"{T("Generic contribution")} "
            + ValueLabel(
                capacity.GenericContribution,
                capacity.GenericContributionUnavailableReason);
        return HasUnavailableCapacity(capacity)
            ? $"{label}. {CapacityUnavailableReason(capacity)}"
            : label;
    }

    private string SkillCellAriaLabel(
        LoadoutComparisonCategoryViewModel category,
        LoadoutComparisonSkillRowViewModel skill,
        LoadoutComparisonColumnViewModel column,
        LoadoutComparisonSkillCellViewModel? cell)
    {
        var parts = new List<string>
        {
            skill.Name ?? T("Unnamed skill"),
            category.DisplayName,
            ColumnLabel(column)
        };
        if (!string.IsNullOrWhiteSpace(skill.NameUnavailableReason))
        {
            parts.Add(T(skill.NameUnavailableReason));
        }
        if (column.Status != LoadoutComparisonColumnStatus.Available)
        {
            parts.Add(ColumnStatusLabel(column));
            if (!string.IsNullOrWhiteSpace(column.Diagnostic))
            {
                parts.Add(T(column.Diagnostic));
            }
        }
        else if (cell is null)
        {
            parts.Add(AbsentLabel(column.Kind));
        }
        else
        {
            parts.Add(MembershipLabel(cell));
            parts.Add(
                $"{T("Effective cost")} "
                + ValueLabel(
                    cell.EffectiveCost,
                    cell.EffectiveCostUnavailableReason));
            if (cell.EffectiveCost is null
                && !string.IsNullOrWhiteSpace(
                    cell.EffectiveCostUnavailableReason))
            {
                parts.Add(T(cell.EffectiveCostUnavailableReason));
            }
            parts.AddRange(cell.Actions.Select(action =>
                $"{ActionLabel(action)}. {T(action.Reason)}"));
            if (!string.IsNullOrWhiteSpace(cell.MembershipUnavailableReason))
            {
                parts.Add(T(cell.MembershipUnavailableReason));
            }
        }

        return string.Join(". ", parts);
    }

    private static LoadoutComparisonColumnKind PolicyColumn(
        RecommendationPolicy policy) => policy switch
        {
            RecommendationPolicy.Safe => LoadoutComparisonColumnKind.Safe,
            RecommendationPolicy.Balanced =>
                LoadoutComparisonColumnKind.Balanced,
            RecommendationPolicy.Aggressive =>
                LoadoutComparisonColumnKind.Aggressive,
            _ => throw new ArgumentOutOfRangeException(nameof(policy))
        };

    private static string PolicyCss(RecommendationPolicy policy) =>
        policy.ToString().ToLowerInvariant();

    private static string CategoryHeadingId(SkillCategory category) =>
        $"comparison-category-{category.ToString().ToLowerInvariant()}";

    private static string CategoryHref(SkillCategory category) =>
        $"#{CategoryHeadingId(category)}";

    private string T(string english) => UiText.Get(Language, english);
}
