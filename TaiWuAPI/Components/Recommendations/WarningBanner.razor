@using TaiWuAPI.Presentation

<section class="warning-banner"
         aria-labelledby="warning-heading"
         aria-live="polite">
    <div class="panel-heading">
        <div>
            <p class="eyebrow">@T("Review before setup")</p>
            <h2 id="warning-heading">@T("Warnings and unavailable information")</h2>
        </div>
        @if (Warnings.Any(warning => warning.IsCritical))
        {
            <span class="critical-label">@T("Critical review required")</span>
        }
    </div>

    <div class="warning-list">
        @foreach (var group in GroupedWarnings)
        {
            var warning = group.Warning;
            <article class="@(warning.IsCritical ? "warning-item critical" : "warning-item")">
                <div>
                    <span class="warning-kind">@WarningKindLabel(warning.Kind)</span>
                    @if (warning.IsCritical)
                    {
                        <strong>@T("Critical")</strong>
                    }
                </div>
                <h3>@WarningTitle(warning)</h3>
                @if (group.RelatedWarnings > 1)
                {
                    <p class="warning-occurrences">
                        @T("Combined") @group.RelatedWarnings @T("related warnings.")
                    </p>
                }
                @if (group.EvaluatedCombinations > 1)
                {
                    <p class="warning-occurrences">
                        @T("Aggregated from") @group.EvaluatedCombinations @T("evaluated combinations.")
                    </p>
                }
                @if (group.Messages.Count == 1)
                {
                    <p>@T(group.Messages[0])</p>
                }
                else
                {
                    <ul class="warning-details-list">
                        @foreach (var message in group.Messages)
                        {
                            <li>@T(message)</li>
                        }
                    </ul>
                }
                <p class="warning-effect">
                    <strong>@T("Effect on recommendation:")</strong>
                    @T(warning.EffectOnRecommendation)
                </p>
                @if (group.EvidenceSourceCount > 0)
                {
                    <div class="warning-evidence" aria-label="@T("Warning evidence")">
                        <span>
                            @WarningTitle(warning) ·
                            @group.EvidenceSourceCount
                            @T("evidence source(s)")
                        </span>
                    </div>
                }
            </article>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<RecommendationWarningViewModel> Warnings { get; set; } = [];

    [CascadingParameter]
    public TaiwuLanguage Language { get; set; } = TaiwuLanguage.English;

    private IReadOnlyList<WarningGroup> GroupedWarnings =>
        [.. Warnings
            .GroupBy(warning => new
            {
                warning.Code,
                warning.Kind,
                warning.IsCritical,
                warning.EffectOnRecommendation
            })
            .Select(group => new WarningGroup(
                group.OrderBy(value => value.Reference, StringComparer.Ordinal)
                    .First(),
                group.Count(),
                group.Where(value => value.Occurrences > 1)
                    .Sum(value => value.Occurrences),
                [.. group.Select(value => value.Message)
                    .Distinct(StringComparer.Ordinal)
                    .Order(StringComparer.Ordinal)],
                group.SelectMany(value => value.EvidenceReferences)
                    .Distinct(StringComparer.Ordinal)
                    .Count()))
            .OrderByDescending(value => value.Warning.IsCritical)
            .ThenBy(value => value.Warning.Kind)
            .ThenBy(value => value.Warning.Reference, StringComparer.Ordinal)];

    private string WarningKindLabel(
        PresentationWarningKind kind) => kind switch
    {
        PresentationWarningKind.StaleData => T("Stale data"),
        PresentationWarningKind.ObservationDifference =>
            T("Observation difference"),
        PresentationWarningKind.UnavailableValue => T("Unavailable value"),
        PresentationWarningKind.UnverifiedMechanic =>
            T("Unverified mechanic"),
        PresentationWarningKind.CandidateSearch => T("Candidate search"),
        PresentationWarningKind.General => T("General"),
        _ => kind.ToString()
    };

    private string WarningTitle(RecommendationWarningViewModel warning) =>
        warning.Code switch
        {
            "TARGET_LOADOUT_UNAVAILABLE" => T("Target loadout unavailable"),
            "TARGET_EQUIPPED_SKILLS_UNAVAILABLE" =>
                T("Target equipped skills unavailable"),
            "UNRECOGNIZED_TARGET_MECHANIC" =>
                T("Unrecognized target mechanic"),
            _ => WarningKindLabel(warning.Kind)
        };

    private sealed record WarningGroup(
        RecommendationWarningViewModel Warning,
        int RelatedWarnings,
        int EvaluatedCombinations,
        IReadOnlyList<string> Messages,
        int EvidenceSourceCount);

    private string T(string english) => UiText.Get(Language, english);
}
