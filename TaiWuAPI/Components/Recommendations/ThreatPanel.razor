@using TaiWu.Domain.CombatThreats
@using TaiWuAPI.Presentation

<section class="threat-panel" aria-labelledby="target-threats-heading">
    <div class="panel-heading">
        <div>
            <p class="eyebrow">Target analysis</p>
            <h3 id="target-threats-heading">Target threats</h3>
        </div>
        @if (SelectedReference is not null)
        {
            <button type="button"
                    class="text-button"
                    @onclick="() => SelectedReferenceChanged.InvokeAsync(null)">
                Clear focus
            </button>
        }
    </div>

    @foreach (var group in Threats
        .OrderByDescending(threat => threat.Severity)
        .ThenBy(threat => threat.Code, StringComparer.Ordinal)
        .GroupBy(threat => threat.Severity))
    {
        <div class="threat-group">
            <h4>@SeverityLabel(group.Key)</h4>
            @foreach (var threat in group)
            {
                var selected = threat.Reference == SelectedReference;
                <button type="button"
                        class="@(selected ? "threat-card selected" : "threat-card")"
                        aria-pressed="@selected"
                        @onclick="() => SelectedReferenceChanged.InvokeAsync(threat.Reference)">
                    <span class="severity-marker">@group.Key</span>
                    <strong>@threat.Title</strong>
                    <span>@threat.Explanation</span>
                    <small>
                        @TimingLabel(threat.ActivationTiming) ·
                        @threat.EvidenceReferences.Count evidence source(s)
                    </small>
                </button>
            }
        </div>
    }

    <p class="panel-hint">
        Select a threat to highlight the skills and plan steps that address it.
    </p>
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ThreatViewModel> Threats { get; set; } = [];

    [Parameter]
    public string? SelectedReference { get; set; }

    [Parameter]
    public EventCallback<string?> SelectedReferenceChanged { get; set; }

    private static string SeverityLabel(
        TargetThreatSeverity severity) => severity switch
    {
        TargetThreatSeverity.Critical => "Critical",
        TargetThreatSeverity.High => "High",
        TargetThreatSeverity.Moderate => "Moderate",
        TargetThreatSeverity.Informational => "Information",
        _ => severity.ToString()
    };

    private static string TimingLabel(
        TargetThreatActivationTiming timing) => timing switch
    {
        TargetThreatActivationTiming.CombatStart => "At combat start",
        TargetThreatActivationTiming.Always => "Always active",
        TargetThreatActivationTiming.OnSkillUse => "On skill use",
        TargetThreatActivationTiming.OnHit => "On hit",
        TargetThreatActivationTiming.OnMarkApplied => "When a mark is applied",
        TargetThreatActivationTiming.Threshold => "At mark threshold",
        TargetThreatActivationTiming.Unknown => "Timing unavailable",
        _ => timing.ToString()
    };
}
