@using TaiWuAPI.Presentation

<section class="@CssClass"
         role="@Role"
         aria-live="@LiveRegion"
         aria-busy="@State.IsLoading.ToString().ToLowerInvariant()">
    <div>
        <span class="state-label">@StatusLabel()</span>
        <strong>@T(State.Title)</strong>
        <p>@T(State.Message)</p>
        @if (!string.IsNullOrWhiteSpace(State.Recovery))
        {
            <p class="state-recovery">
                <strong>@T("Next step:")</strong>
                @T(State.Recovery)
            </p>
        }
    </div>
    @if (State.CanRetryRead)
    {
        <button type="button"
                class="secondary-button"
                @onclick="RetryRead"
                disabled="@RetryDisabled">
            @T("Retry read")
        </button>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public RecommendationPageState State { get; set; } = default!;

    [Parameter]
    public EventCallback RetryRead { get; set; }

    [Parameter]
    public bool RetryDisabled { get; set; }

    [CascadingParameter]
    public TaiwuLanguage Language { get; set; } = TaiwuLanguage.English;

    private string T(string english) => UiText.Get(Language, english);

    private string StatusLabel() => Language == TaiwuLanguage.Chinese
        ? State.Status switch
        {
            RecommendationPageStatus.Initial => "開始",
            RecommendationPageStatus.Loading => "讀取中",
            RecommendationPageStatus.TargetReady => "目標就緒",
            RecommendationPageStatus.Empty => "沒有結果",
            RecommendationPageStatus.AmbiguousTarget => "多個目標",
            RecommendationPageStatus.Success => "完成",
            RecommendationPageStatus.SuccessWithWarning => "完成但有警告",
            RecommendationPageStatus.InvalidConfiguration => "設定錯誤",
            RecommendationPageStatus.UnsupportedVersion => "不支援",
            RecommendationPageStatus.Failure => "失敗",
            _ => State.Status.ToString()
        }
        : State.Status.ToString();

    private string CssClass =>
        State.IsProblem
            ? "message-card page-state problem-state"
            : "message-card page-state";

    private string Role => State.IsProblem ? "alert" : "status";

    private string LiveRegion => State.IsProblem ? "assertive" : "polite";
}
