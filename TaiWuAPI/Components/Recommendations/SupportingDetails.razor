@using TaiWuAPI.Presentation

<section class="supporting-details recommendation-only"
         aria-labelledby="supporting-details-heading">
    <div class="panel-heading">
        <div>
            <p class="eyebrow">@T("Supporting detail")</p>
            <h3 id="supporting-details-heading">@T("Verify the recommendation")</h3>
        </div>
    </div>

    <p class="unknown-policy">@T(Details.UnknownValuePolicy)</p>

    <div class="supporting-panels">
        <details>
            <summary>
                @T("Assumptions and unavailable data")
                <span>@(Details.Assumptions.Count + Details.UnavailableData.Count)</span>
            </summary>
            <div class="support-list">
                @foreach (var caveat in Details.Assumptions)
                {
                    <article>
                        <strong>@T("Assumption")</strong>
                        <span>@T(caveat.Explanation)</span>
                    </article>
                }
                @foreach (var caveat in Details.UnavailableData)
                {
                    <article>
                        <strong>@T("Unavailable data")</strong>
                        <span>@T(caveat.Explanation)</span>
                    </article>
                }
                @if (Details.Assumptions.Count == 0
                     && Details.UnavailableData.Count == 0)
                {
                    <p>@T("No additional assumption or unavailable-data caveat was produced.")</p>
                }
            </div>
        </details>

        <details>
            <summary>
                @T("Detailed evidence")
                <span>@Details.EvidenceReferences.Count</span>
            </summary>
            <div class="evidence-list">
                @foreach (var evidence in Details.EvidenceSummaries)
                {
                    <article>
                        <strong>@T(evidence.Name)</strong>
                        <span>
                            @T(evidence.Kind) · @evidence.SourceCount
                            @T("evidence source(s)")
                        </span>
                    </article>
                }
                @if (Details.EvidenceReferences.Count == 0)
                {
                    <p>@T("No evidence reference was available.")</p>
                }
            </div>
        </details>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public RecommendationSupportingDetailsViewModel Details { get; set; } =
        default!;

    [CascadingParameter]
    public TaiwuLanguage Language { get; set; } = TaiwuLanguage.English;

    private string T(string english) => UiText.Get(Language, english);

}
