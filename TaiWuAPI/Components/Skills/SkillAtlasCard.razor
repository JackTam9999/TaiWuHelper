@using TaiWu.Application.CombatSkills
@using TaiWu.Domain.CombatSkills
@using TaiWu.Domain.CombatSnapshots

<article class="skill-atlas-card @GradeClass"
         data-reference="@Entry.StableKey"
         data-grade="@GradeValue">
    <details>
        <summary aria-label="@SummaryAriaLabel">
            <span class="skill-glyph" aria-hidden="true">
                <span>@SkillInitial</span>
            </span>
            <span class="skill-card-title">
                @if (ShowCollapsedPrimaryStatus)
                {
                    <span class="skill-card-status @PrimaryStatusClass">@PrimaryStatusText</span>
                }
                <span class="skill-card-name-line">
                    @if (ActiveMarkerDirection is { } activeDirection)
                    {
                        <span class="practice-marker @DirectionClass(activeDirection)"
                              data-practice-state="active"
                              role="img"
                              aria-label="@DirectionLabel(activeDirection)">
                            <span aria-hidden="true">@DirectionGlyph(activeDirection)</span>
                        </span>
                    }
                    else if (ReadyDirections.Count > 0)
                    {
                        <span class="breakthrough-prefix">@T("Breakthrough")</span>
                        @foreach (var readyDirection in ReadyDirections)
                        {
                            <span class="practice-marker @DirectionClass(readyDirection)"
                                  data-practice-state="available"
                                  role="img"
                                  aria-label="@DirectionLabel(readyDirection)">
                                <span aria-hidden="true">@DirectionGlyph(readyDirection)</span>
                            </span>
                        }
                    }
                    <strong title="@DisplayName">@DisplayName</strong>
                </span>
            </span>
        </summary>

        <div class="skill-card-body">
            <div class="skill-badges"
                 role="list"
                 aria-label="@T("Character progress")">
                @if (IsTrue(Entry.Learned))
                {
                    <span class="progress-badge learned" role="listitem">@T("Learned")</span>
                }
                @if (Breakthrough?.CanBreakthroughNow == true)
                {
                    <span class="progress-badge ready" role="listitem">@T("Ready to break through")</span>
                }
                @if (Breakthrough?.IsBrokenOut == true)
                {
                    <span class="progress-badge broken" role="listitem">@T("Broken through")</span>
                }
                @if (ActiveMarkerDirection is { } direction)
                {
                    <span class="progress-badge direction" role="listitem">@DirectionLabel(direction)</span>
                }
                @if (IsTrue(Progress?.AttainmentMastered))
                {
                    <span class="progress-badge mastered" role="listitem">@T("Mastered")</span>
                }
                @if (IsTrue(Progress?.Simplified))
                {
                    <span class="progress-badge simplified" role="listitem">@T("Simplified")</span>
                }
                @if (IsTrue(Progress?.Activated))
                {
                    <span class="progress-badge active" role="listitem">@T("Activated")</span>
                }
                @if (IsTrue(Progress?.Equipped))
                {
                    <span class="progress-badge equipped" role="listitem">@T("Equipped")</span>
                }
                @if (!HasPositiveProgressBadge)
                {
                    <span class="progress-badge neutral" role="listitem">@NonPositiveStatusText</span>
                }
            </div>

            <dl class="skill-card-facts">
                <div class="skill-study-fact">
                    <dt>@T("Study progress")</dt>
                    @if (OrderedStudyDetails.Count > 0)
                    {
                        <dd class="skill-study-progress">
                            <span class="skill-study-strip"
                                  role="list"
                                  aria-label="@StudyText">
                                @foreach (var detail in OrderedStudyDetails)
                                {
                                    <span class="skill-study-glyph @StudyDetailStatusClass(detail) @StudyDetailPathClass(detail) @StudyDetailActiveClass(detail)"
                                          data-study-detail="@detail.DetailId"
                                          data-study-status="@StudyDetailStatusKey(detail)"
                                          role="listitem"
                                          aria-label="@StudyDetailAriaLabel(detail)"
                                          title="@StudyDetailAriaLabel(detail)">
                                        <span aria-hidden="true">@StudyDetailGlyph(detail)</span>
                                    </span>
                                }
                            </span>
                            <span class="skill-study-summary">@StudyText</span>
                        </dd>
                    }
                    else
                    {
                        <dd>@StudyText</dd>
                    }
                </div>
                <div>
                    <dt>@T("Proficiency")</dt>
                    <dd>@ProficiencyText</dd>
                </div>
                <div>
                    <dt>@T("Base grid cost")</dt>
                    <dd>@BaseCostText</dd>
                </div>
                <div>
                    <dt>@T("Current effective cost")</dt>
                    <dd>@EffectiveCostText</dd>
                </div>
            </dl>

            @if (Entry.Issues != CombatSkillQueryIssue.None)
            {
                <p class="skill-partial-note">
                    @T("Some fields are unavailable or use a fallback. Open the detail view for provenance.")
                </p>
            }

            <a class="skill-detail-link" href="/skills/@Entry.SkillId">
                @T("Open full skill detail") <span aria-hidden="true">→</span>
            </a>
        </div>
    </details>
</article>

@code {
    [Parameter, EditorRequired]
    public CharacterCombatSkillAtlasEntry Entry { get; set; } = default!;

    [CascadingParameter]
    public TaiwuLanguage Language { get; set; } = TaiwuLanguage.English;

    private CharacterCombatSkillProgress? Progress => Entry.Progress;

    private BreakthroughDirectionAvailability? Breakthrough =>
        Progress?.Breakthrough.IsAvailable == true
            ? Progress.Breakthrough.Value
            : null;

    private PracticeDirection? ActiveDirection =>
        Progress?.ActiveDirection.IsAvailable == true
            ? Progress.ActiveDirection.Value
            : null;

    private PracticeDirection? ActiveMarkerDirection =>
        Breakthrough?.IsBrokenOut == true
        && ActiveDirection is PracticeDirection.Direct
            or PracticeDirection.Reverse
            ? ActiveDirection
            : null;

    private IReadOnlyList<PracticeDirection> ReadyDirections =>
        Breakthrough?.CanBreakthroughNow == true
            ? new[]
                {
                    PracticeDirection.Direct,
                    PracticeDirection.Reverse
                }
                .Where(Breakthrough.Includes)
                .ToArray()
            : [];

    private string DisplayName => Entry.DisplayName.Value.IsAvailable
        ? Entry.DisplayName.Value.Value.Text
        : T("Unnamed skill");

    private string SummaryAriaLabel => string.Join(
        " · ",
        new[]
        {
            DisplayName,
            GradeText,
            CategoryText,
            FactionText,
            PrimaryStatusText
        }
            .Where(value => !string.IsNullOrWhiteSpace(value)));

    private string FactionText =>
        Entry.Definition?.Faction.IsAvailable == true
            ? CombatSkillUiText.Faction(
                Language,
                Entry.Definition.Faction.Value)
            : T("Unknown faction");

    private string CategoryText =>
        Entry.Definition?.Category.IsAvailable == true
            ? CategoryLabel(Entry.Definition.Category.Value)
            : T("Unknown category");

    private string GradeText => Entry.Definition?.Grade.IsAvailable == true
        ? $"{T("Grade")} {Entry.Definition.Grade.Value.Value}"
        : T("Grade unavailable");

    private string GradeClass => Entry.Definition?.Grade.IsAvailable == true
        ? $"grade-{Entry.Definition.Grade.Value.Value}"
        : "grade-unknown";

    private string GradeValue => Entry.Definition?.Grade.IsAvailable == true
        ? Entry.Definition.Grade.Value.Value.ToString()
        : "unknown";

    private string PrimaryStatusText => PrimaryProgressStatusText;

    private bool ShowCollapsedPrimaryStatus =>
        IsTrue(Progress?.AttainmentMastered)
        || Breakthrough?.IsBrokenOut != true
        || ActiveMarkerDirection is null;

    private string PrimaryProgressStatusText => IsTrue(Progress?.AttainmentMastered)
        ? T("Mastered")
        : Breakthrough?.IsBrokenOut == true
            ? T("Broken through")
            : Breakthrough?.CanBreakthroughNow == true
                ? T("Ready to break through")
                : IsTrue(Entry.Learned)
                    ? T("Learned")
                    : NonPositiveStatusText;

    private string NonPositiveStatusText => Entry.Learned.IsAvailable
        ? T("Not learned")
        : T("Status unavailable");

    private string PrimaryStatusClass => IsTrue(Progress?.AttainmentMastered)
        ? "mastered"
        : Breakthrough?.IsBrokenOut == true
            ? "broken"
            : Breakthrough?.CanBreakthroughNow == true
                ? "ready"
                : IsTrue(Entry.Learned)
                    ? "learned"
                    : "neutral";

    private string SkillInitial => string.IsNullOrWhiteSpace(DisplayName)
        ? "?"
        : DisplayName.Trim()[0].ToString();

    private string BaseCostText => Entry.BaseGridCost.IsAvailable
        ? Entry.BaseGridCost.Value.Value.ToString()
        : T("Unavailable");

    private string EffectiveCostText =>
        Entry.CurrentEffectiveGridCost.IsAvailable
            ? Entry.CurrentEffectiveGridCost.Value.ToString()
            : T("Unavailable");

    private string ProficiencyText =>
        Progress?.Proficiency.Current.IsAvailable == true
            ? Progress.Proficiency.Maximum.IsAvailable
                ? $"{Progress.Proficiency.Current.Value} / {Progress.Proficiency.Maximum.Value}"
                : Progress.Proficiency.Current.Value.ToString()
            : T("Unavailable");

    private string StudyText => Progress is null
        ? Entry.Learned.IsAvailable && !Entry.Learned.Value
            ? T("Not learned")
            : T("Unavailable")
        : Progress.StudySummary.TotalCount == 0
            ? T("Unavailable")
            : $"{Progress.StudySummary.ReadCount} / {Progress.StudySummary.TotalCount} {T("studied")}";

    private IReadOnlyList<CombatSkillStudyDetailProgress> OrderedStudyDetails =>
        Progress?.StudyDetails
            .OrderBy(detail => detail.DisplayOrder)
            .ToArray()
        ?? [];

    private string StudyDetailLabel(CombatSkillStudyDetailProgress detail) =>
        detail.Label.IsAvailable
            ? detail.Label.Value
            : $"{T("Unnamed detail")} ({detail.DetailId})";

    private string StudyDetailGlyph(CombatSkillStudyDetailProgress detail)
    {
        var label = StudyDetailLabel(detail).Trim();
        return label.Length == 0 ? "?" : label[0].ToString();
    }

    private static string StudyDetailStatusKey(
        CombatSkillStudyDetailProgress detail) =>
        detail.ReadState.IsAvailable
            ? detail.ReadState.Value == CombatSkillStudyState.Read
                ? "studied"
                : "not-studied"
            : "unavailable";

    private static string StudyDetailStatusClass(
        CombatSkillStudyDetailProgress detail) =>
        $"status-{StudyDetailStatusKey(detail)}";

    private static string StudyDetailActiveClass(
        CombatSkillStudyDetailProgress detail) =>
        detail.IsActive.IsAvailable && detail.IsActive.Value
            ? "is-active"
            : string.Empty;

    private string StudyDetailPathClass(
        CombatSkillStudyDetailProgress detail) =>
        StudyDetailGlyph(detail) switch
        {
            "用" or "奇" or "巧" or "化" or "絕" => "study-path-red",
            "修" or "思" or "源" or "參" or "藏" => "study-path-blue",
            _ => string.Empty
        };

    private string StudyDetailStatusLabel(
        CombatSkillStudyDetailProgress detail) =>
        detail.ReadState.IsAvailable
            ? detail.ReadState.Value == CombatSkillStudyState.Read
                ? T("Studied")
                : T("Not studied")
            : T("Unavailable");

    private string StudyDetailAriaLabel(
        CombatSkillStudyDetailProgress detail) =>
        detail.IsActive.IsAvailable && detail.IsActive.Value
            ? $"{StudyDetailLabel(detail)} · {StudyDetailStatusLabel(detail)} · {T("Active detail")}"
            : $"{StudyDetailLabel(detail)} · {StudyDetailStatusLabel(detail)}";

    private bool HasPositiveProgressBadge => IsTrue(Entry.Learned)
        || Breakthrough?.CanBreakthroughNow == true
        || Breakthrough?.IsBrokenOut == true
        || ActiveMarkerDirection is not null
        || IsTrue(Progress?.AttainmentMastered)
        || IsTrue(Progress?.Simplified)
        || IsTrue(Progress?.Activated)
        || IsTrue(Progress?.Equipped);

    private static bool IsTrue(SkillProgressField<bool>? field) =>
        field?.IsAvailable == true && field.Value;

    private string DirectionLabel(PracticeDirection direction) =>
        direction switch
        {
            PracticeDirection.Direct => T("Direct practice"),
            PracticeDirection.Reverse => T("Reverse practice"),
            _ => T("Unavailable")
        };

    private static string DirectionGlyph(PracticeDirection direction) =>
        direction == PracticeDirection.Direct ? "正" : "逆";

    private static string DirectionClass(PracticeDirection direction) =>
        direction == PracticeDirection.Direct ? "direct" : "reverse";

    private string CategoryLabel(CombatSkillDiscipline category) =>
        CombatSkillUiText.Category(Language, category);

    private string T(string english) => UiText.Get(Language, english);
}
